# The one message a day. Triggered by dooodhwala-digest.timer.
[Unit]
Description=DOOODHWALA daily digest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=dooodhwala
WorkingDirectory=/home/dooodhwala/DOOODHWALA
ExecStart=/home/dooodhwala/DOOODHWALA/deploy/daily-digest.sh
